#!/bin/bash
# git tidy — switch to the default branch, fast-forward it, and delete clean
# worktrees and local branches whose work has already landed there.
#
# Work in progress is never destroyed. A dirty tree, a detached HEAD or a paused
# rebase/merge keeps the current branch checked out (the default branch is still
# brought up to date in place), and a branch is only deleted once every one of
# its commits is proven to be in the default branch already. Nothing is reset,
# forced or cleaned, and the default branch is only ever fast-forwarded.
#
#   git tidy              switch, update, remove merged worktrees and branches
#   git tidy -n           show what it would do, change nothing
#   git tidy --no-worktrees
#                         leave existing worktrees in place and only tidy branches
#   git tidy --squashed   also delete branches that landed as a squash merge.
#                         They share no commit with the default branch, so this
#                         compares diffs instead of ancestry: a weaker proof,
#                         which is why it is opt-in.
#
# Git cannot tell whether another tool intends to resume work in an otherwise
# safe worktree. Lock such a worktree to preserve it. Ignored files are removed
# with an eligible worktree.
set -euo pipefail

dry_run=false
squashed=false
remove_worktrees=true
for arg in "$@"; do
  case "$arg" in
    -n|--dry-run) dry_run=true ;;
    --no-worktrees) remove_worktrees=false ;;
    --squashed) squashed=true ;;
    -h|--help) awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"; exit 0 ;;
    *) echo "git tidy: unknown option: $arg" >&2; exit 2 ;;
  esac
done

# Fails with git's own message when this is not a repository.
git_dir=$(git rev-parse --git-dir)

say() { printf '%s\n' "$*"; }
act() { if ! $dry_run; then "$@"; fi; }

# Prefers what the remote calls its default, recording it so later runs need no
# network. origin/HEAD is a symbolic ref and keeps resolving after the branch it
# names is renamed or deleted, so it is only trusted when it still points at a
# ref that exists; otherwise the whole run would target a branch that is gone.
# Falls back to the usual names for a repository without a remote.
resolve_default() {
  local ref name
  ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null || true)
  if [ -n "$ref" ] && ! git show-ref --verify --quiet "$ref"; then ref=""; fi
  if [ -z "$ref" ] && git remote get-url origin >/dev/null 2>&1; then
    git remote set-head origin --auto >/dev/null 2>&1 || true
    ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null || true)
    if [ -n "$ref" ] && ! git show-ref --verify --quiet "$ref"; then ref=""; fi
  fi
  if [ -n "$ref" ]; then printf '%s\n' "${ref#refs/remotes/origin/}"; return 0; fi
  for name in main master trunk; do
    if git show-ref --verify --quiet "refs/heads/$name"; then printf '%s\n' "$name"; return 0; fi
  done
  return 1
}

# Why the checkout has to be left where it is, or empty when it may be switched.
holding() {
  if [ -n "$(git status --porcelain)" ]; then say "uncommitted changes"; return 0; fi
  if [ -d "$git_dir/rebase-merge" ] || [ -d "$git_dir/rebase-apply" ]; then say "a rebase in progress"; return 0; fi
  if [ -f "$git_dir/MERGE_HEAD" ]; then say "a merge in progress"; return 0; fi
  if [ -f "$git_dir/CHERRY_PICK_HEAD" ]; then say "a cherry-pick in progress"; return 0; fi
  if [ -f "$git_dir/BISECT_LOG" ]; then say "a bisect in progress"; return 0; fi
  if ! git symbolic-ref --quiet HEAD >/dev/null 2>&1; then say "a detached HEAD"; return 0; fi
  return 0
}

# A squash merge leaves no commit in common, so the branch is replayed as one
# commit on the merge base and its patch looked for in the default branch.
landed_as_squash() {
  local branch=$1 base_commit tree replayed
  base_commit=$(git merge-base "$default" "$branch" 2>/dev/null) || return 1
  tree=$(git rev-parse "$branch^{tree}")
  replayed=$(git commit-tree "$tree" -p "$base_commit" -m tidy)
  case "$(git cherry "$default" "$replayed")" in "-"*) return 0 ;; *) return 1 ;; esac
}

# Why a linked worktree must be preserved, or empty when Git may remove it.
worktree_holding() {
  local path=$1 worktree_git_dir
  if [ -n "$(git -C "$path" status --porcelain)" ]; then say "uncommitted changes"; return 0; fi
  worktree_git_dir=$(git -C "$path" rev-parse --absolute-git-dir 2>/dev/null) || {
    say "cannot inspect"; return 0;
  }
  if [ -d "$worktree_git_dir/rebase-merge" ] || [ -d "$worktree_git_dir/rebase-apply" ]; then say "a rebase in progress"; return 0; fi
  if [ -f "$worktree_git_dir/MERGE_HEAD" ]; then say "a merge in progress"; return 0; fi
  if [ -f "$worktree_git_dir/CHERRY_PICK_HEAD" ]; then say "a cherry-pick in progress"; return 0; fi
  if [ -f "$worktree_git_dir/BISECT_LOG" ]; then say "a bisect in progress"; return 0; fi
  return 0
}

has_origin=false
if git remote get-url origin >/dev/null 2>&1; then
  has_origin=true
  git fetch --prune --quiet origin
fi

# After the fetch, so a branch the remote has just dropped is already gone.
if ! default=$(resolve_default); then
  say "git tidy: cannot tell which branch is the default." >&2
  say "  set it with: git remote set-head origin --auto" >&2
  exit 1
fi

# Only drops registrations whose directory is already gone.
act git worktree prune

current=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
held=$(holding)
checkout_note=""
update_note=""
default_up_to_date=false

if [ "$current" != "$default" ]; then
  if [ -n "$held" ]; then
    checkout_note="stayed on ${current:-detached HEAD}: $held"
  else
    act git switch --quiet "$default"
    $dry_run || current=$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  fi
fi

# Fast-forward only, checked out or not: a default branch that has diverged
# locally is something to look at, not something to overwrite. Git refuses on
# its own if local edits are in the way, which is the answer we want anyway.
if $has_origin && git show-ref --verify --quiet "refs/remotes/origin/$default"; then
  if [ "$current" = "$default" ]; then
    act git merge --ff-only --quiet "origin/$default" || update_note="could not fast-forward $default; left alone"
  else
    act git fetch --quiet origin "$default:$default" || update_note="could not fast-forward $default; left alone"
  fi
fi

if ! $dry_run && $has_origin && git show-ref --verify --quiet "refs/remotes/origin/$default"; then
  if [ "$(git rev-parse "refs/heads/$default")" = "$(git rev-parse "refs/remotes/origin/$default")" ]; then
    default_up_to_date=true
  fi
fi

removed_worktrees=0
removed_worktree_names=""
removable_worktree_branches=""
kept_worktrees=0
kept_worktree_names=""
# Removing a worktree is mostly filesystem work (typically deleting a large
# node_modules tree). Run a few removals together so one slow directory does not
# serialize every other cleanup, while keeping the fan-out low enough not to
# overwhelm the disk.
worktree_remove_jobs=4
worktree_remove_pids=()
worktree_remove_paths=()
worktree_remove_labels=()
worktree_remove_branches=()
record_worktree_kept() {
  kept_worktrees=$((kept_worktrees + 1))
  kept_worktree_names="${kept_worktree_names}${kept_worktree_names:+
}  $1 ($2)"
}

finish_worktree_removals() {
  local i path label branch
  for ((i = 0; i < ${#worktree_remove_pids[@]}; i++)); do
    path=${worktree_remove_paths[$i]}
    label=${worktree_remove_labels[$i]}
    branch=${worktree_remove_branches[$i]}
    if wait "${worktree_remove_pids[$i]}"; then
      removed_worktrees=$((removed_worktrees + 1))
      removed_worktree_names="${removed_worktree_names}${removed_worktree_names:+
}  $path ($label)"
      if [ -n "$branch" ]; then
        removable_worktree_branches="${removable_worktree_branches}${removable_worktree_branches:+
}$branch"
      fi
    else
      record_worktree_kept "$path" "removal failed"
    fi
  done
  worktree_remove_pids=()
  worktree_remove_paths=()
  worktree_remove_labels=()
  worktree_remove_branches=()
}

remove_worktree() {
  local path=$1 label=$2 branch=$3
  if $dry_run; then
    removed_worktrees=$((removed_worktrees + 1))
    removed_worktree_names="${removed_worktree_names}${removed_worktree_names:+
}  $path ($label)"
    if [ -n "$branch" ]; then
      removable_worktree_branches="${removable_worktree_branches}${removable_worktree_branches:+
}$branch"
    fi
    return 0
  fi

  git worktree remove -- "$path" &
  worktree_remove_pids+=("$!")
  worktree_remove_paths+=("$path")
  worktree_remove_labels+=("$label")
  worktree_remove_branches+=("$branch")
  if [ "${#worktree_remove_pids[@]}" -ge "$worktree_remove_jobs" ]; then
    finish_worktree_removals
  fi
}

if $remove_worktrees; then
  current_root=$(git rev-parse --show-toplevel)
  worktree_number=0
  worktree_path=""
  worktree_head=""
  worktree_branch=""
  worktree_locked=false
  worktree_prunable=false

  inspect_worktree() {
    local label held landed
    [ -n "$worktree_path" ] || return 0
    worktree_number=$((worktree_number + 1))

    # Git lists the primary worktree first. The checkout running this command
    # and the default branch are also never removal candidates.
    [ "$worktree_number" -ne 1 ] || return 0
    [ "$worktree_path" != "$current_root" ] || return 0
    [ "$worktree_branch" != "$default" ] || return 0

    label=${worktree_branch:-detached HEAD at ${worktree_head:0:7}}
    if $worktree_locked; then
      record_worktree_kept "$worktree_path" "locked"; return 0
    fi
    if $worktree_prunable || [ ! -d "$worktree_path" ]; then
      record_worktree_kept "$worktree_path" "directory missing; registration will be pruned"; return 0
    fi

    held=$(worktree_holding "$worktree_path")
    if [ -n "$held" ]; then
      record_worktree_kept "$worktree_path" "$held"; return 0
    fi

    landed=false
    git merge-base --is-ancestor "$worktree_head" "$default" 2>/dev/null && landed=true
    if ! $landed && $squashed && [ -n "$worktree_branch" ] && landed_as_squash "$worktree_branch"; then
      landed=true
    fi
    if ! $landed; then
      record_worktree_kept "$worktree_path" "unmerged"; return 0
    fi

    remove_worktree "$worktree_path" "$label" "$worktree_branch"
  }

  # Porcelain records are separated by a blank line. Avoid a pipeline here so
  # the counters changed by inspect_worktree remain in this shell.
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "") inspect_worktree; worktree_path=""; worktree_head=""; worktree_branch=""; worktree_locked=false; worktree_prunable=false ;;
      "worktree "*) worktree_path=${line#worktree } ;;
      "HEAD "*) worktree_head=${line#HEAD } ;;
      "branch refs/heads/"*) worktree_branch=${line#branch refs/heads/} ;;
      locked*) worktree_locked=true ;;
      prunable*) worktree_prunable=true ;;
    esac
  done < <(git worktree list --porcelain)
  inspect_worktree
  finish_worktree_removals
fi

# A branch checked out in another worktree is in use, and git would refuse it.
elsewhere=$(git worktree list --porcelain | sed -n 's|^branch refs/heads/||p')
if $dry_run && $remove_worktrees && [ -n "$removable_worktree_branches" ]; then
  still_elsewhere=""
  while IFS= read -r branch; do
    case $'\n'"$removable_worktree_branches"$'\n' in
      *$'\n'"$branch"$'\n'*) continue ;;
    esac
    still_elsewhere="${still_elsewhere}${still_elsewhere:+
}$branch"
  done <<< "$elsewhere"
  elsewhere=$still_elsewhere
fi
deleted=0
deleted_names=""
kept=0
kept_names=""
record_kept() {
  kept=$((kept + 1))
  kept_names="${kept_names}${kept_names:+
}  $1 ($2)"
}

# Collect results without printing the individual steps.
for branch in $(git for-each-ref --format='%(refname:short)' refs/heads/); do
  [ "$branch" = "$default" ] && continue
  [ "$branch" = "$current" ] && continue

  merged=false
  git merge-base --is-ancestor "$branch" "$default" 2>/dev/null && merged=true

  case $'\n'"$elsewhere"$'\n' in
    *$'\n'"$branch"$'\n'*)
      record_kept "$branch" "in use by worktree"; continue ;;
  esac

  reason=""
  if $merged; then
    reason="merged"
  elif $squashed && landed_as_squash "$branch"; then
    reason="squashed"
  fi
  if [ -z "$reason" ]; then
    record_kept "$branch" "unmerged"; continue
  fi

  # `git branch -d` answers a different question: it compares against the
  # upstream when a branch has one, so a stale remote-tracking ref makes it
  # refuse work that is demonstrably in the default branch. Ancestry, checked
  # just above, is the property that means nothing can be lost.
  if act git branch --quiet -D "$branch"; then
    deleted=$((deleted + 1))
    deleted_names="${deleted_names}${deleted_names:+
}  $branch"
  else
    record_kept "$branch" "deletion failed"
  fi
done

# Report the checkout actually inspected, including for dry runs.
result_current=${current:-detached HEAD}
if $dry_run; then
  say "Dry run: on $result_current"
else
  if $default_up_to_date && [ "$current" = "$default" ]; then
    say "On $result_current (up to date)"
  else
    say "On $result_current"
    if $default_up_to_date; then say "$default: up to date"; fi
  fi
fi
[ -z "$checkout_note" ] || say "$checkout_note"
[ -z "$update_note" ] || say "$update_note"
if $remove_worktrees; then
  say ""
  if $dry_run; then
    say "Would remove worktrees: $removed_worktrees"
  else
    say "Removed worktrees: $removed_worktrees"
  fi
  [ "$removed_worktrees" -eq 0 ] || say "$removed_worktree_names"
  say ""
  say "Kept worktrees: $kept_worktrees"
  [ "$kept_worktrees" -eq 0 ] || say "$kept_worktree_names"
fi
say ""
if $dry_run; then
  say "Would delete branches: $deleted"
else
  say "Deleted branches: $deleted"
fi
[ "$deleted" -eq 0 ] || say "$deleted_names"
say ""
if $dry_run; then
  say "Would keep branches: $kept"
else
  say "Kept branches: $kept"
fi
[ "$kept" -eq 0 ] || say "$kept_names"
exit 0
